<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!--
      USAGE STATS: reads per-app foreground time. This is a "special app access"
      permission granted in Settings > Special access > Usage access; it cannot
      be granted at runtime and is the only supported source of app usage data.
    -->
    <!--
      INTERNET: Reader downloads RSS/Atom feeds, Hacker News items and dev.to
      articles. The WebView and image loading also need it.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!--
      PACKAGE VISIBILITY: lists launchable apps for the picker. On Android 11+
      installed apps are hidden without this. Only package name, label and a
      system flag are read and stored locally.
    -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!--
      OVERLAY: draws the full-screen block screen above the blocked app
      (used from Stage 3). Checked and explained in onboarding from Stage 1.
    -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!--
      NOTIFICATIONS: the blocking foreground service must show a persistent
      notification (Stage 3); on Android 13+ it also needs this runtime grant.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      BATTERY: asks the user to exempt Lockout from battery optimisation so the
      watcher is not killed by OEM battery managers.
    -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!--
      BOOT: re-arms the midnight alarm and restarts the watcher after a reboot.
      Alarms do not survive a restart, so this receiver is required for the lock
      to keep working after the device is turned off overnight.
    -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
      EXACT ALARM: schedules the 00:00 reset with AlarmManager. This is a special
      access on Android 12+ (Settings > Special access > Alarms & reminders); the
      app checks canScheduleExactAlarms() and falls back to an inexact,
      doze-safe alarm, with the service poll recovering any delay.
    -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!--
      FOREGROUND SERVICE: the watcher must keep running while another app is in
      the foreground. Since Android 14 the "special use" subtype is the correct
      category for continuous usage monitoring, and it needs its own permission
      plus the declared subtype on the service element below.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <application
        android:label="Lockout"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!--
          Block screen shown above a blocked app. It lives in its own task and
          is excluded from recents so it cannot be "swiped away" back into the
          monitored app, and the platform Material theme avoids paying for a
          Flutter engine just to draw one screen.
        -->
        <activity
            android:name=".platform.BlockActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:taskAffinity="com.lockout.lockout.block"
            android:theme="@android:style/Theme.Material.NoActionBar" />

        <!--
          Foreground watcher: polls the foreground app every 2 s and shows the
          block screen. "specialUse" is the Android 14+ category for continuous
          usage monitoring; the property is required for that category.
        -->
        <service
            android:name=".platform.BlockingService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:stopWithTask="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Monitors foreground app usage against the user's daily limit and shows the block screen." />
        </service>

        <!--
          Midnight reset. Exported=false: the alarm uses an explicit
          PendingIntent, so only Lockout can trigger this receiver.
        -->
        <receiver
            android:name=".platform.MidnightReceiver"
            android:exported="false" />

        <!--
          The 5-minute usage warning's "Add 10 min" action. The action is only
          present in that notification; the app UI deliberately has no
          equivalent control. Exported=false because the PendingIntent is
          explicit and only Lockout can send it.
        -->
        <receiver
            android:name=".platform.UsageAlertActionReceiver"
            android:exported="false" />

        <!--
          Boot/time-change recovery. Exported=true is required to receive these
          protected system broadcasts; RECEIVE_BOOT_COMPLETED restricts who can
          deliver BOOT_COMPLETED.
        -->
        <receiver
            android:name=".platform.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
